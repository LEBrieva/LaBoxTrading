generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  authId    String    @unique @map("auth_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  hasCompletedOnboarding Boolean       @default(false) @map("has_completed_onboarding")
  accounts              Account[]
  strategies     Strategy[]
  journalEntries JournalEntry[]
  feedbacks      Feedback[]

  @@map("users")
}

model Account {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  broker         Broker   @default(SIMPLEFX)
  initialCapital Float    @map("initial_capital")
  currentCapital Float    @map("current_capital")
  targetCapital  Float    @map("target_capital")
  currency       String   @default("USD")
  walletAddress  String?  @map("wallet_address")
  walletNetwork  String?  @map("wallet_network")
  riskRules      Json?    @map("risk_rules")
  createdAt      DateTime      @default(now()) @map("created_at")
  trades         Trade[]
  transactions   AccountTransaction[]

  @@map("accounts")
}

model Trade {
  id         String      @id @default(cuid())
  accountId  String      @map("account_id")
  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pair       String
  direction  Direction
  entry      Float?
  stopLoss   Float?      @map("stop_loss")
  takeProfit Float?      @map("take_profit")
  size       Float?
  riskUsd    Float       @default(0) @map("risk_usd")
  riskPct    Float       @default(0) @map("risk_pct")
  externalId String?     @unique @map("external_id")
  notes      String?
  imageUrl   String?     @map("image_url")
  openedAt   DateTime    @default(now()) @map("opened_at")
  closedAt   DateTime?   @map("closed_at")
  status     TradeStatus @default(OPEN)
  positions  Position[]
  images     TradeImage[]
  checklist  TradeChecklist?

  @@index([accountId, status])
  @@index([accountId, openedAt])
  @@map("trades")
}

model TradeImage {
  id        String   @id @default(cuid())
  tradeId   String   @map("trade_id")
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tradeId])
  @@map("trade_images")
}

model Position {
  id         String         @id @default(cuid())
  tradeId    String         @map("trade_id")
  trade      Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  label      String
  status     PositionStatus @default(OPEN)
  size       Float?
  pnl        Float          @default(0)
  closePrice Float?         @map("close_price")
  closedAt   DateTime?      @map("closed_at")
  isPartial  Boolean        @default(false) @map("is_partial")
  partialPct Float?         @map("partial_pct")
  externalId String?        @unique @map("external_id")

  @@index([tradeId])
  @@map("positions")
}

enum Broker {
  SIMPLEFX
  BITGET
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum PositionStatus {
  OPEN
  TP
  SL
  BE
  PARTIAL
}

model Strategy {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  fields      Json
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  checklists  TradeChecklist[]

  @@index([userId])
  @@map("strategies")
}

model TradeChecklist {
  id         String    @id @default(cuid())
  tradeId    String    @unique @map("trade_id")
  trade      Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  strategyId String?   @map("strategy_id")
  strategy   Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  values     Json
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([strategyId])
  @@map("trade_checklists")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ADJUSTMENT
}

model AccountTransaction {
  id        String          @id @default(cuid())
  accountId String          @map("account_id")
  account   Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Float
  note      String?
  date      DateTime        @default(now())
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([accountId, date])
  @@map("transactions")
}

enum Mood {
  GREAT
  GOOD
  NEUTRAL
  BAD
  TERRIBLE
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  content   String
  mood      Mood     @default(NEUTRAL)
  tags      String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("journal_entries")
}

model Symbol {
  id           String @id @default(cuid())
  name         String
  broker       Broker @default(SIMPLEFX)
  category     String
  decimals     Int    @default(2)
  contractSize Float  @default(1) @map("contract_size")

  @@unique([name, broker])
  @@map("symbols")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("feedbacks")
}
